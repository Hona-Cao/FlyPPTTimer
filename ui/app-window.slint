import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct SettingItem {
    key: string,
    label: string,
    kind: int,
    value: string,
    checked: bool,
    options: [string],
    selected: int,
    enabled: bool,
    read-only: bool,
    button-text: string,
    row-height: int,
}

export struct RuleItem {
    file-name: string,
    file-path: string,
    duration: string,
    mode: int,
    enabled: bool,
    selected: bool,
}

export struct PresentationItem {
    name: string,
    path: string,
    duration: string,
    mode: int,
    enabled: bool,
    is-rule: bool,
}

export component AppWindow inherits Window {
    in property <string> display-text: "08:00";
    in property <brush> surface-color: #f3f8fc;
    in property <color> foreground-color: #0b3a66;
    in property <length> timer-font-size: 18px;
    in property <string> timer-font-family: "Microsoft YaHei UI";
    in property <int> timer-font-weight: 700;
    in property <bool> timer-font-italic: false;
    in property <length> corner-radius: 7px;
    in property <bool> keep-on-top: true;
    in property <bool> drag-enabled: true;
    in property <bool> flash-text-visible: true;
    in property <bool> flash-background-active: false;
    in property <bool> flash-border-active: false;
    in property <color> flash-color: #4ea3d8;
    out property <length> required-text-width: time-text.preferred-width + 8px;
    out property <length> required-text-height: time-text.preferred-height + 4px;

    callback begin-drag();
    callback drag-move();
    callback end-drag();
    callback show-menu();

    title: "";
    width: 100px;
    height: 35px;
    no-frame: true;
    always-on-top: root.keep-on-top;
    background: root.flash-background-active ? root.flash-color : root.surface-color;

    Rectangle {
        background: root.flash-background-active ? root.flash-color : root.surface-color;
        border-radius: root.corner-radius;
        border-width: root.flash-border-active ? 3px : 0px;
        border-color: root.flash-color;

        time-text := Text {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text: root.display-text;
            color: root.foreground-color;
            font-family: root.timer-font-family;
            font-size: root.timer-font-size;
            font-weight: root.timer-font-weight;
            font-italic: root.timer-font-italic;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            visible: root.flash-text-visible;
        }

        TouchArea {
            enabled: true;
            pointer-event(event) => {
                if root.drag-enabled && event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.begin-drag();
                }
                if root.drag-enabled && event.kind == PointerEventKind.move {
                    root.drag-move();
                }
                if root.drag-enabled && ((event.button == PointerEventButton.left && event.kind == PointerEventKind.up) || event.kind == PointerEventKind.cancel) {
                    root.end-drag();
                }
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    root.show-menu();
                }
            }
        }
    }
}
export component BigScreenWindow inherits Window {
    in property <string> display-text: "08:00";
    in property <brush> surface-color: #f3f8fc;
    in property <color> foreground-color: #0b3a66;
    in property <string> timer-font-family: "Microsoft YaHei UI";
    in property <bool> keep-on-top: true;
    in property <length> timer-font-size: 162px;

    title: "FlyPPTTimer";
    preferred-width: 960px;
    preferred-height: 540px;
    min-width: 640px;
    min-height: 360px;
    no-frame: false;
    always-on-top: root.keep-on-top;
    background: root.surface-color;

    Rectangle {
        background: root.surface-color;
        Text {
            width: parent.width;
            height: parent.height;
            text: root.display-text;
            color: root.foreground-color;
            font-family: root.timer-font-family;
            font-size: root.timer-font-size;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component TimeUpWindow inherits Window {
    in property <string> message: "时间到";
    callback dismiss();

    title: "";
    no-frame: true;
    always-on-top: true;
    background: #000000;

    Rectangle {
        background: #000000;
        Text {
            width: parent.width;
            height: parent.height;
            text: root.message;
            color: #ffffff;
            font-family: "Microsoft YaHei UI";
            font-size: 72px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { clicked => { root.dismiss(); } }
    }
}

// Desktop management windows only. Timer colors remain driven by user configuration.
global DesktopTheme {
    out property <color> canvas: #eef2f7;
    out property <color> surface: #ffffff;
    out property <color> subtle: #f3f6fa;
    out property <color> text: #1e293b;
    out property <color> secondary: #475569;
    out property <color> muted: #64748b;
    out property <color> border: #e2e8f0;
    out property <color> accent: #2563eb;
    out property <color> accent-hover: #1d4ed8;
    out property <color> accent-pressed: #1e40af;
    out property <color> selected: #eff6ff;
    out property <color> success: #15803d;
    out property <color> warning: #b45309;
    out property <color> danger: #b42318;
    out property <color> danger-soft: #fff3f2;
    out property <color> danger-hover: #fee4e2;
    out property <color> danger-pressed: #fecdca;
    out property <color> disabled-text: #94a3b8;
    out property <color> pressed: #e2e8f0;
    out property <color> scrim: #66000000;
}

component RemoteButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();
    forward-focus: keyboard;

    border-radius: 8px;
    border-width: 1px;
    border-color: !root.enabled ? DesktopTheme.border : root.primary ? DesktopTheme.accent : root.danger ? DesktopTheme.danger : DesktopTheme.border;
    background: !root.enabled ? DesktopTheme.subtle
        : root.primary ? (hit.pressed ? DesktopTheme.accent-pressed : hit.has-hover ? DesktopTheme.accent-hover : DesktopTheme.accent)
        : root.danger ? (hit.pressed ? DesktopTheme.danger-pressed : hit.has-hover ? DesktopTheme.danger-hover : DesktopTheme.danger-soft)
        : hit.pressed ? DesktopTheme.pressed : hit.has-hover ? DesktopTheme.selected : DesktopTheme.surface;

    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.text;
        color: !root.enabled ? DesktopTheme.disabled-text : root.primary ? DesktopTheme.surface : root.danger ? DesktopTheme.danger : DesktopTheme.secondary;
        font-size: 12px;
        font-weight: root.primary ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    if keyboard.has-focus && root.enabled: Rectangle {
        x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px;
        background: transparent; border-radius: 4px; border-width: 2px;
        border-color: root.primary ? DesktopTheme.surface : DesktopTheme.accent;
    }

    keyboard := FocusScope {
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { return accept; }
            return reject;
        }
        key-released(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component PresentationWindow inherits Window {
    in property <string> window-title: "远程控制";
    in property <[PresentationItem]> presentations;
    in-out property <int> selected-presentation: -1;
    in-out property <string> goto-page: "1";
    in-out property <string> rule-duration: "00:08:00";
    in-out property <int> rule-mode: 0;
    in-out property <bool> rule-enabled: true;
    in property <[string]> timer-modes: ["倒计时", "正计时"];
    in property <string> open-text: "打开演示文稿";
    in property <string> beginning-text: "从头放映";
    in property <string> current-text: "当前页放映";
    in property <string> previous-text: "上一页";
    in property <string> next-text: "下一页";
    in property <string> goto-text: "跳转";
    in property <string> black-text: "黑屏";
    in property <string> white-text: "白屏";
    in property <string> restore-text: "恢复";
    in property <string> end-text: "结束放映";
    in property <string> close-active-text: "关闭当前文档";
    in property <string> close-managed-text: "关闭最后打开的文稿";
    in property <string> exit-text: "退出演示软件";
    in-out property <bool> confirm-exit: false;
    in property <string> confirm-title: "确认退出软件";
    in property <string> confirm-message: "将强制关闭全部 PowerPoint/WPS 演示进程，未保存内容会丢失。";
    in property <string> cancel-command-text: "取消";
    in property <string> add-file-text: "添加";
    in property <string> delete-file-text: "删除";
    in property <string> refresh-list-text: "刷新";
    in property <string> clear-list-text: "清空列表";
    in property <string> rule-duration-text: "时长";
    in property <string> rule-mode-text: "模式";
    in property <string> rule-status-text: "状态";
    in property <string> rule-enabled-text: "启用规则";
    in property <string> rule-disabled-text: "禁用规则";
    in property <string> save-rule-text: "保存";
    in-out property <int> current-page: 0;
    in property <string> connection-page-text: "远程连接";
    in property <string> presentation-page-text: "演示文稿";
    in property <string> connection-subtitle-text: "通过手机或浏览器控制演示";
    in property <string> presentation-subtitle-text: "规则与放映";
    in property <string> service-status-text;
    in property <string> current-port-text;
    in property <string> next-port-label: "下次服务端口";
    in-out property <string> next-port: "4080";
    in property <string> client-count-text;
    in property <string> recommended-url;
    in property <string> address-list-text;
    in property <image> qr-image;
    in property <string> restart-service-text: "重启远程服务";
    in property <string> service-toggle-text: "停止服务";
    in property <string> apply-port-text: "重启远程服务并应用端口";
    in property <string> regenerate-token-text: "重新生成令牌";
    in property <string> disconnect-text: "断开所有设备";
    in property <string> copy-address-text: "复制访问地址";
    in property <string> open-local-text: "打开本机控制页";
    in property <string> firewall-text;
    in property <string> copy-firewall-text: "复制修复命令";

    callback command(int, string);
    callback remote-action(int, string, bool);
    callback rule-action(int, string);
    callback presentation-selected(int);

    title: root.window-title;
    preferred-width: 700px;
    preferred-height: 620px;
    min-width: 700px;
    min-height: 620px;
    background: DesktopTheme.canvas;

    Rectangle {
        x: 24px; y: 16px; width: parent.width - 48px; height: 40px;
        background: DesktopTheme.subtle; border-radius: 8px;
        Rectangle {
            x: root.current-page == 0 ? 4px : parent.width / 2;
            y: 4px; width: parent.width / 2 - 4px; height: 32px;
            background: DesktopTheme.surface; border-radius: 8px;
        }
        Text { x: 0; width: parent.width / 2; height: parent.height; text: root.connection-page-text; color: DesktopTheme.text; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: parent.width / 2; width: parent.width / 2; height: parent.height; text: root.presentation-page-text; color: DesktopTheme.text; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { enabled: !root.confirm-exit; x: 0; width: parent.width / 2; clicked => { root.current-page = 0; } }
        TouchArea { enabled: !root.confirm-exit; x: parent.width / 2; width: parent.width / 2; clicked => { root.current-page = 1; } }
    }

    Text {
        x: 28px; y: 64px; width: parent.width - 56px; height: 18px;
        text: root.current-page == 0 ? root.connection-subtitle-text : root.presentation-subtitle-text;
        color: DesktopTheme.muted; font-size: 13px; vertical-alignment: center;
    }

    Rectangle {
        visible: root.current-page == 0;
        x: 24px; y: 88px; width: parent.width - 48px; height: parent.height - 102px;
        background: DesktopTheme.surface; border-radius: 12px; border-width: 1px; border-color: DesktopTheme.border;

        ScrollView {
            x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                Rectangle {
                    height: max(148px, recommended.y + recommended.preferred-height + 8px);
                    Text { x: 0; y: 0; width: parent.width - 164px; height: 28px; text: root.service-status-text; color: DesktopTheme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    Text { x: 0; y: 36px; width: parent.width - 164px; height: 22px; text: root.current-port-text; color: DesktopTheme.secondary; font-size: 13px; vertical-alignment: center; }
                    Text { x: 0; y: 60px; width: parent.width - 164px; height: 22px; text: root.client-count-text; color: DesktopTheme.secondary; font-size: 13px; vertical-alignment: center; }
                    recommended := Text { x: 0; y: 94px; width: parent.width - 164px; height: self.preferred-height; text: root.recommended-url; color: DesktopTheme.accent; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                    Image { x: parent.width - 144px; y: 0; width: 144px; height: 144px; source: root.qr-image; image-fit: contain; }
                }
                Text { text: root.address-list-text; color: DesktopTheme.muted; font-size: 12px; wrap: word-wrap; }
                Rectangle { height: 1px; background: DesktopTheme.border; }
                HorizontalLayout {
                    height: 36px; spacing: 12px;
                    Text { width: 120px; text: root.next-port-label; color: DesktopTheme.secondary; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                    LineEdit { enabled: !root.confirm-exit; width: 96px; text <=> root.next-port; }
                }
                RemoteButton { enabled: !root.confirm-exit; height: 36px; text: root.apply-port-text; primary: true; clicked => { root.remote-action(1, root.next-port, false); } }
                HorizontalLayout {
                    height: 36px; spacing: 12px;
                    RemoteButton { enabled: !root.confirm-exit; text: root.service-toggle-text; clicked => { root.remote-action(7, "", false); } }
                    RemoteButton { enabled: !root.confirm-exit; text: root.restart-service-text; clicked => { root.remote-action(0, "", false); } }
                }
                HorizontalLayout {
                    height: 36px; spacing: 12px;
                    RemoteButton { enabled: !root.confirm-exit; text: root.regenerate-token-text; clicked => { root.remote-action(2, "", false); } }
                    RemoteButton { enabled: !root.confirm-exit; text: root.disconnect-text; clicked => { root.remote-action(3, "", false); } }
                }
                HorizontalLayout {
                    height: 40px; spacing: 12px;
                    RemoteButton { enabled: !root.confirm-exit; text: root.copy-address-text; clicked => { root.remote-action(4, "", false); } }
                    RemoteButton { enabled: !root.confirm-exit; text: root.open-local-text; clicked => { root.remote-action(5, "", false); } }
                    RemoteButton { enabled: !root.confirm-exit; text: root.copy-firewall-text; clicked => { root.remote-action(6, "", false); } }
                }
                Text { text: root.firewall-text; color: DesktopTheme.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
    }

    Rectangle {
        visible: root.current-page == 1;
        x: 24px; y: 88px; width: parent.width - 48px; height: root.height - 250px;
        background: DesktopTheme.surface; border-radius: 10px; border-width: 1px; border-color: DesktopTheme.border;
        ScrollView {
            x: 8px; y: 7px; width: parent.width - 16px; height: parent.height - 14px;
            VerticalLayout {
                width: parent.width;
                spacing: 4px;
                for item[index] in root.presentations: Rectangle {
                    height: 72px; border-radius: 8px;
                    background: root.selected-presentation == index ? DesktopTheme.selected : transparent;
                    border-width: root.selected-presentation == index ? 1px : 0px;
                    border-color: DesktopTheme.accent;
                    Text { x: 10px; y: 4px; width: parent.width - 228px; height: 22px; text: item.name; color: DesktopTheme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                    Text { x: 10px; y: 28px; width: parent.width - 20px; height: 20px; text: item.path; color: DesktopTheme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
                    Text { x: parent.width - 208px; y: 4px; width: 80px; height: 22px; text: item.duration; color: DesktopTheme.secondary; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                    Text { x: parent.width - 120px; y: 4px; width: 110px; height: 22px; text: item.is-rule ? root.timer-modes[item.mode] : ""; color: DesktopTheme.secondary; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                    Text { x: parent.width - 240px; y: 50px; width: 230px; height: 20px; text: item.is-rule ? (item.enabled ? root.rule-enabled-text : root.rule-disabled-text) : ""; color: item.enabled ? DesktopTheme.success : DesktopTheme.warning; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                    TouchArea { enabled: !root.confirm-exit; x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { root.selected-presentation = index; root.presentation-selected(index); } }
                }
            }
        }
    }

    Rectangle { visible: root.current-page == 1 && root.selected-presentation >= 0; x: 24px; y: root.height - 162px; width: parent.width - 48px; height: 74px; background: DesktopTheme.subtle; border-radius: 8px; border-width: 1px; border-color: DesktopTheme.border;
        Text { x: 12px; y: 7px; width: 46px; height: 18px; text: root.rule-duration-text; color: DesktopTheme.secondary; font-size: 12px; vertical-alignment: center; }
        LineEdit { enabled: !root.confirm-exit; x: 56px; y: 8px; width: 104px; height: 32px; text <=> root.rule-duration; }
        Text { x: 176px; y: 7px; width: 46px; height: 18px; text: root.rule-mode-text; color: DesktopTheme.secondary; font-size: 12px; vertical-alignment: center; }
        ComboBox { enabled: !root.confirm-exit; x: 220px; y: 8px; width: 118px; height: 32px; model: root.timer-modes; current-index <=> root.rule-mode; }
        RemoteButton { enabled: !root.confirm-exit; x: parent.width - 98px; y: 8px; width: 86px; height: 32px; text: root.save-rule-text; primary: true; clicked => { root.rule-action(4, root.rule-duration); } }
    }

    RemoteButton { enabled: !root.confirm-exit; visible: root.current-page == 1; x: 24px; y: root.height - 78px; width: (parent.width - 64px) / 3; height: 36px; text: root.add-file-text; clicked => { root.rule-action(0, ""); } }
    RemoteButton { visible: root.current-page == 1; x: 32px + (parent.width - 64px) / 3; y: root.height - 78px; width: (parent.width - 64px) / 3; height: 36px; text: root.delete-file-text; enabled: (root.selected-presentation >= 0) && !root.confirm-exit; clicked => { root.rule-action(1, ""); } }
    RemoteButton { enabled: !root.confirm-exit; visible: root.current-page == 1; x: 40px + 2 * (parent.width - 64px) / 3; y: root.height - 78px; width: (parent.width - 64px) / 3; height: 36px; text: root.clear-list-text; clicked => { root.rule-action(3, ""); } }


    if root.confirm-exit && root.current-page == 1: Rectangle {
        init => { exit-cancel.focus(); }
        background: DesktopTheme.scrim;
        TouchArea { }
        Rectangle {
            x: (parent.width - 460px) / 2; y: (parent.height - 220px) / 2;
            width: 460px; height: 220px; background: DesktopTheme.surface; border-radius: 12px; border-width: 1px; border-color: DesktopTheme.border;
            Text { x: 24px; y: 22px; width: parent.width - 48px; height: 30px; text: root.confirm-title; color: DesktopTheme.danger; font-size: 19px; font-weight: 700; vertical-alignment: center; }
            Text { x: 24px; y: 64px; width: parent.width - 48px; height: 76px; text: root.confirm-message; color: DesktopTheme.secondary; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
            exit-cancel := RemoteButton { x: 244px; y: 162px; width: 88px; height: 36px; text: root.cancel-command-text; clicked => { root.confirm-exit = false; } }
            RemoteButton { x: 342px; y: 162px; width: 94px; height: 36px; text: root.exit-text; danger: true; clicked => { root.confirm-exit = false; root.command(13, ""); } }
        }
    }
}
component FieldRow inherits Rectangle {
    in property <SettingItem> item;
    in property <int> row-index;
    in property <bool> interactive: true;
    callback edited(int, string, bool, int);
    callback action(int);

    property <length> control-x: min(260px, self.width * 0.44);
    property <length> control-width: self.width - self.control-x - 16px;
    height: item.kind == 0 ? (row-index == 0 ? 40px : 56px)
        : item.kind == 5 ? 44px
        : max(item.row-height > 0 ? item.row-height * 1px : 48px, field-label.preferred-height + 20px);
    background: item.kind == 0 ? DesktopTheme.canvas : DesktopTheme.surface;
    border-radius: 8px;
    border-width: item.kind == 0 ? 0px : 1px;
    border-color: DesktopTheme.border;

    if item.kind != 0: Rectangle {
        x: 16px; y: parent.height - 1px;
        width: parent.width - 32px; height: 1px;
        background: DesktopTheme.border;
    }

    if item.kind == 0: Text {
        x: 16px;
        y: root.row-index == 0 ? 0px : 16px;
        width: parent.width - 32px;
        height: 40px;
        text: item.label;
        color: DesktopTheme.text;
        font-size: 14px;
        font-weight: 700;
        vertical-alignment: center;
    }

    field-label := Text {
        visible: item.kind >= 1 && item.kind <= 4;
        x: 16px;
        y: 8px;
        width: root.control-x - 32px;
        height: parent.height - 16px;
        text: item.label;
        color: DesktopTheme.secondary;
        font-size: 13px;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    if item.kind == 1: CheckBox {
        x: root.control-x;
        y: (parent.height - 32px) / 2;
        width: root.control-width;
        height: 32px;
        checked: item.checked;
        text: item.button-text;
        enabled: item.enabled && root.interactive;
        toggled => { root.edited(row-index, "", self.checked, 0); }
    }

    if item.kind == 2: LineEdit {
        x: root.control-x;
        y: (parent.height - 32px) / 2;
        width: item.read-only || item.key == "" ? root.control-width : min(200px, root.control-width);
        height: 32px;
        text: item.value;
        read-only: item.read-only;
        enabled: item.enabled && root.interactive;
        edited(value) => { root.edited(row-index, value, false, 0); }
    }

    if item.kind == 3: ComboBox {
        x: root.control-x;
        y: (parent.height - 32px) / 2;
        width: root.control-width;
        height: 32px;
        model: item.options;
        current-index: item.selected;
        enabled: item.enabled && root.interactive;
        selected(value) => { root.edited(row-index, value, false, self.current-index); }
    }

    if item.kind == 4: Button {
        x: root.control-x;
        y: (parent.height - 34px) / 2;
        width: root.control-width;
        height: 34px;
        text: item.button-text;
        enabled: item.enabled && root.interactive;
        clicked => { root.action(row-index); }
    }

    if item.kind == 5: Button {
        x: 16px; y: 5px; width: parent.width - 32px; height: 34px;
        text: item.label;
        enabled: root.interactive;
        clicked => { root.action(root.row-index); }
    }

}
export component SettingsWindow inherits Window {
    in property <string> settings-title: "FlyPPTTimer Settings";
    in property <[string]> pages;
    in property <[SettingItem]> items;
    in property <[RuleItem]> rules;
    in property <int> current-page: 0;
    in property <int> selected-rule: -1;
    in property <int> selected-rule-count: 0;
    in property <bool> dirty: false;
    in property <string> dirty-text;
    in property <string> ok-text;
    in property <string> cancel-text;
    in property <string> apply-text;
    in property <string> rule-add-text;
    in property <string> rule-delete-text;
    in property <string> rule-clear-text;
    in property <string> rule-batch-text;
    in property <string> rule-file-label;
    in property <string> rule-path-label;
    in property <string> rule-duration-label;
    in property <string> rule-mode-label;
    in property <string> rule-status-label;
    in property <[string]> timer-modes;
    in-out property <bool> batch-open: false;
    in-out property <bool> dialog-open: false;
    in-out property <bool> dialog-restart: false;
    in property <string> dialog-title;
    in property <string> dialog-message;
    property <bool> modal-open: root.batch-open || root.dialog-open;
    callback dialog-confirm();
    callback big-screen-disabled();
    in-out property <string> batch-duration: "00:08:00";
    in-out property <int> batch-mode: 0;
    in property <string> batch-title;
    in property <string> batch-count-text;
    in property <string> batch-duration-label;
    in property <string> batch-mode-label;
    in-out property <length> preview-scroll-y: 0px;

    callback navigate(int);
    callback field-edited(int, string, bool, int);
    callback field-action(int);
    callback rule-selected(int, bool, bool);
    callback rule-edited(int, string, bool, int);
    callback rule-action(int);
    callback batch-confirm(string, int);
    callback accept();
    callback cancel();
    callback apply();

    title: root.settings-title;
    // Keep the initial size comfortable while allowing the native decorated
    // settings window to be resized.  The minimum is large enough to keep the
    // six-page navigation and the form rows readable at the narrowest layout.
    preferred-width: 900px;
    preferred-height: 650px;
    min-width: 760px;
    min-height: 520px;
    background: DesktopTheme.canvas;

    Rectangle {
        x: 0;
        width: 196px;
        height: parent.height;
        background: DesktopTheme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: DesktopTheme.border;

        Text {
            x: 24px;
            y: 28px;
            text: "FlyPPTTimer";
            color: DesktopTheme.text;
            font-size: 21px;
            font-weight: 700;
        }

        for page[index] in pages: Rectangle {
            x: 12px;
            y: 74px + index * 44px;
            width: 172px;
            height: 36px;
            border-radius: 8px;
            background: root.current-page == index ? DesktopTheme.selected : transparent;

            Text {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                text: page;
                color: root.current-page == index ? DesktopTheme.accent : DesktopTheme.secondary;
                font-size: 14px;
                vertical-alignment: center;
            }
            TouchArea { enabled: !root.modal-open; clicked => { root.navigate(index); } }
        }
    }

    Rectangle {
        x: 196px;
        width: parent.width - 196px;
        height: parent.height - 58px;
        background: DesktopTheme.canvas;

        Text {
            x: 22px;
            y: 18px;
            text: pages[root.current-page];
            color: DesktopTheme.text;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: top;
        }

        ScrollView {
            x: 18px;
            y: 56px;
            width: parent.width - 36px;
            height: parent.height - 64px;
            viewport-y <=> root.preview-scroll-y;

            VerticalLayout {
                width: parent.width;
                spacing: 0px;
                padding-bottom: 12px;

                for item[index] in root.items: FieldRow {
                    width: parent.width;
                    item: item;
                    interactive: !root.modal-open;
                    row-index: index;
                    edited(index, value, checked, selected) => { root.field-edited(index, value, checked, selected); }
                    action(index) => { root.field-action(index); }
                }

                if root.current-page == 0: Rectangle {
                    height: root.rules.length > 0 ? root.rules.length * 56px + 12px : 72px;
                    background: DesktopTheme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: DesktopTheme.border;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        for rule[index] in root.rules: Rectangle {
                            height: 52px;
                            border-radius: 8px;
                            background: rule.selected ? DesktopTheme.selected : transparent;
                            CheckBox { enabled: !root.modal-open;
                                x: 8px; y: 12px; width: 24px;
                                checked: rule.enabled;
                                toggled => { root.rule-edited(index, "enabled", self.checked, 0); }
                            }
                            Text {
                                x: 40px; y: 4px; width: parent.width - 250px; height: 20px;
                                text: rule.file-name; color: DesktopTheme.text; font-size: 13px; overflow: elide;
                            }
                            Text {
                                x: 40px; y: 29px; width: parent.width - 52px; height: 19px;
                                text: rule.file-path; color: DesktopTheme.muted; font-size: 12px; overflow: elide;
                            }
                            Text {
                                x: parent.width - 200px; y: 4px; width: 80px; height: 20px;
                                text: rule.duration; color: DesktopTheme.secondary; vertical-alignment: center;
                            }
                            Text {
                                x: parent.width - 112px; y: 4px; width: 104px; height: 20px;
                                text: root.timer-modes[rule.mode]; color: DesktopTheme.secondary; vertical-alignment: center;
                            }
                            TouchArea { enabled: !root.modal-open; x: 32px; width: parent.width - 32px; pointer-event(event) => { if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.rule-selected(index, event.modifiers.control, event.modifiers.shift); } } }
                        }
                    }
                }

                if root.current-page == 0: Rectangle {
                    height: 48px;
                    background: transparent;
                    HorizontalLayout {
                        y: 7px; height: 34px;
                        alignment: end;
                        spacing: 8px;
                        Button { enabled: !root.modal-open; text: root.rule-add-text; clicked => { root.rule-action(0); } }
                        Button { text: root.rule-delete-text; enabled: (root.selected-rule-count > 0) && !root.modal-open; clicked => { root.rule-action(1); } }
                        Button { text: root.rule-clear-text; enabled: (root.rules.length > 0) && !root.modal-open; clicked => { root.rule-action(2); } }
                        Button { text: root.rule-batch-text; enabled: (root.selected-rule-count > 0) && !root.modal-open; clicked => { root.rule-action(3); } }
                    }
                }

                if root.current-page == 0 && root.selected-rule >= 0: Rectangle {
                    height: 132px;
                    background: DesktopTheme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: DesktopTheme.border;
                    Text { x: 14px; y: 20px; width: 116px; text: root.rule-duration-label; color: DesktopTheme.secondary; vertical-alignment: center; }
                    LineEdit { enabled: !root.modal-open;
                        x: 144px; y: 10px; width: parent.width - 160px; height: 34px;
                        text: root.rules[root.selected-rule].duration;
                        edited(value) => { root.rule-edited(root.selected-rule, value, false, 1); }
                    }
                    Text { x: 14px; y: 78px; width: 116px; text: root.rule-mode-label; color: DesktopTheme.secondary; vertical-alignment: center; }
                    ComboBox { enabled: !root.modal-open;
                        x: 144px; y: 68px; width: parent.width - 160px; height: 34px;
                        model: root.timer-modes; current-index: root.rules[root.selected-rule].mode;
                        selected(value) => { root.rule-edited(root.selected-rule, value, false, self.current-index + 2); }
                    }
                }
            }
        }
    }

    Rectangle {
        x: 196px;
        y: parent.height - 58px;
        width: parent.width - 196px;
        height: 58px;
        background: DesktopTheme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: DesktopTheme.border;

        Text {
            x: 20px; width: parent.width - 340px; height: parent.height;
            wrap: word-wrap;
            text: root.dirty ? root.dirty-text : "";
            color: DesktopTheme.warning; font-size: 13px; vertical-alignment: center;
        }
        HorizontalLayout {
            x: parent.width - 310px;
            y: 10px;
            width: 290px;
            height: 36px;
            spacing: 6px;
            Button { enabled: !root.modal-open; text: root.ok-text; clicked => { root.accept(); } }
            Button { enabled: !root.modal-open; text: root.cancel-text; clicked => { root.cancel(); } }
            Button { text: root.apply-text; enabled: (root.dirty) && !root.modal-open; clicked => { root.apply(); } }
        }
    }

    if root.batch-open: Rectangle {
        init => { batch-input.focus(); }
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: DesktopTheme.scrim;
        TouchArea { }
        Rectangle {
            x: (parent.width - 430px) / 2;
            y: (parent.height - 260px) / 2;
            width: 430px; height: 260px;
            background: DesktopTheme.surface; border-radius: 12px; border-width: 1px; border-color: DesktopTheme.border;
            Text { x: 24px; y: 22px; width: parent.width - 48px; text: root.batch-title; color: DesktopTheme.text; font-size: 20px; font-weight: 700; vertical-alignment: top; }
            Text { x: 24px; y: 58px; width: parent.width - 48px; text: root.batch-count-text; color: DesktopTheme.muted; font-size: 13px; vertical-alignment: top; }
            Text { x: 24px; y: 102px; width: 118px; text: root.batch-duration-label; color: DesktopTheme.secondary; vertical-alignment: top; }
            batch-input := LineEdit { x: 148px; y: 92px; width: 258px; height: 34px; text <=> root.batch-duration; }
            Text { x: 24px; y: 150px; width: 118px; text: root.batch-mode-label; color: DesktopTheme.secondary; vertical-alignment: top; }
            ComboBox { x: 148px; y: 140px; width: 258px; height: 34px; model: root.timer-modes; current-index <=> root.batch-mode; }
            Button { x: 222px; y: 202px; width: 88px; height: 36px; text: root.cancel-text; clicked => { root.batch-open = false; } }
            Button { x: 318px; y: 202px; width: 88px; height: 36px; text: root.ok-text; clicked => { root.batch-confirm(root.batch-duration, root.batch-mode); } }
        }
    }
    if root.dialog-open: Rectangle {
        init => { dialog-ok.focus(); }
        background: DesktopTheme.scrim;
        TouchArea { }
        Rectangle {
            width: min(640px, parent.width - 48px);
            height: min(parent.height - 48px, max(202px, min(430px, 130px + dialog-measure.preferred-height)));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: DesktopTheme.surface; border-radius: 12px;
            dialog-measure := Text {
                x: 24px; y: 62px; width: parent.width - 48px;
                height: self.preferred-height;
                text: root.dialog-message;
                wrap: word-wrap;
                opacity: 0;
            }
            Text { x: 24px; y: 18px; width: parent.width - 48px; height: 32px; text: root.dialog-title; font-size: 18px; font-weight: 700; color: DesktopTheme.text; }
            ScrollView {
                x: 24px; y: 62px; width: parent.width - 48px; height: parent.height - 130px;
                Text {
                    width: parent.width;
                    height: self.preferred-height;
                    text: root.dialog-message;
                    wrap: word-wrap;
                    vertical-alignment: top;
                    color: DesktopTheme.text;
                    font-size: 13px;
                }
            }
            Button { visible: root.dialog-restart; x: parent.width - 214px; y: parent.height - 52px; width: 88px; height: 34px; text: root.cancel-text; clicked => { root.dialog-open = false; } }
            dialog-ok := Button { x: parent.width - 112px; y: parent.height - 52px; width: 88px; height: 34px; text: root.ok-text; clicked => { root.dialog-open = false; root.dialog-confirm(); } }
        }
    }

}
